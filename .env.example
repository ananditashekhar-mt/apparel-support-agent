OPENAI_API_KEY=
BRAND_NAME=Threadly
AGENT_NAME=Tia
# Choose a Responses API model enabled in your account; no key needed for Demo.
OPENAI_MODEL=
# Local Ollama uses the OpenAI-compatible endpoint. Model names depend on what you install.
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://localhost:11434/v1
# Optional only for Ollama cloud. The local server ignores this value.
OLLAMA_API_KEY=ollama
# Set these to the published rates for the model selected above.
OPENAI_INPUT_USD_PER_M=0
OPENAI_OUTPUT_USD_PER_M=0
USD_INR_RATE=0
# Use OpenAI for the deployed app; keep Demo while testing without API charges.
APP_MODE=Demo
# Set false in the deployed customer app so customers cannot change modes.
ALLOW_MODE_SWITCH=true
# Required before exposing operations interfaces outside a local demo.
SUPPORT_ACCESS_CODE=
ADMIN_ACCESS_CODE=
